# GEMINI_API_KEY: Required for Gemini AI API calls (AI SEO Growth Engine & Search Intelligence Report).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Search Console OAuth Configuration (Optional - required only for Search Console Mode A)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Server-Side Crawl & Audit Resource Limits
MAX_CRAWL_PAGES="25"
MAX_LINKS_PER_PAGE="120"
MAX_HTML_BYTES="2097152"
MAX_REDIRECTS="5"
REQUEST_TIMEOUT_MS="12000"
